    "@microsoft/sp-webpart-base": "1.18.2",
    "@pnp/sp": "^3.22.0",
    "@pnp/graph": "^3.22.0",
    "@pnp/logging": "^3.22.0",
    "@pnp/common": "^3.22.0",
    "@fluentui/react": "^8.110.10",
    "@fluentui/react-hooks": "^8.6.30",
    "@fluentui/react-icons": "^2.0.220",
    "react": "17.0.1",
    "react-dom": "17.0.1",
    "react-window": "^1.8.10",
    "tslib": "2.3.1"
